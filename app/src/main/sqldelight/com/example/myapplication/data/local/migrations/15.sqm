-- IMDb id для MOVIE/SERIES.
--
-- Второй уровень приоритета идентификации после TMDB и единственный адресный ключ Stremio-транспорта
-- (`tt1254207` для фильма, `tt0898266:9:17` для эпизода). До этой миграции IMDb id доходил только до
-- сетевого слоя (`KinopoiskDto.imdbId`) и терялся, не доживая до записи в библиотеке.
--
-- TEXT, а не INTEGER: канонический IMDb id — строка с префиксом `tt` и значащими ведущими нулями
-- (`tt0412142`). Хранение числом потеряло бы формат и потребовало бы восстановления при каждом
-- обращении.
--
-- Как tmdb_id/kinopoisk_id, эта колонка не участвует в облачной синхронизации: значение выводится
-- из метаданных заново и сохраняется при pull через self-select в `upsertFromSync`.
ALTER TABLE anime ADD COLUMN imdb_id TEXT;
