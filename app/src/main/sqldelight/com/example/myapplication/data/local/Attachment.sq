CREATE TABLE attachment (
    id TEXT PRIMARY KEY,
    anime_id TEXT NOT NULL,
    file_name TEXT NOT NULL,
    cloud_url TEXT,
    is_uploaded INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (anime_id) REFERENCES anime(id) ON DELETE CASCADE
);

getAttachmentsForAnime:
SELECT * FROM attachment WHERE anime_id = ?;

getPendingUploads:
SELECT * FROM attachment WHERE is_uploaded = 0;

insertAttachment:
INSERT OR REPLACE INTO attachment(
    id, anime_id, file_name, cloud_url, is_uploaded, created_at, updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?);

markUploaded:
UPDATE attachment SET is_uploaded = 1, cloud_url = ?, updated_at = ? WHERE id = ?;

deleteAttachment:
DELETE FROM attachment WHERE id = ?;
