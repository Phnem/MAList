CREATE TABLE anime (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    imagePath TEXT,
    episodes INTEGER NOT NULL,
    rating INTEGER NOT NULL,
    status TEXT NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL,
    orderIndex INTEGER NOT NULL DEFAULT 0,
    dateAdded INTEGER NOT NULL,
    categoryType TEXT NOT NULL DEFAULT '',
    sync_status TEXT NOT NULL DEFAULT 'SYNCED',
    comment TEXT NOT NULL DEFAULT '',
    isAiRecommendation INTEGER NOT NULL DEFAULT 0,
    anilist_id INTEGER,
    mal_id INTEGER,
    shikimori_id INTEGER,
    anilist_not_found_at INTEGER,
    mal_not_found_at INTEGER,
    shikimori_not_found_at INTEGER,
    isPrivate INTEGER NOT NULL DEFAULT 0,
    encryptionIv TEXT,
    deletedAt INTEGER,
    mediaType TEXT NOT NULL DEFAULT 'ANIME'
);

-- Delta Sync: rows that need to be pushed to cloud
selectPendingSync:
SELECT * FROM anime WHERE sync_status != 'SYNCED' ORDER BY orderIndex ASC;

CREATE TABLE anime_tags (
    anime_id TEXT NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (anime_id, tag),
    FOREIGN KEY (anime_id) REFERENCES anime(id) ON DELETE CASCADE
);

getAllAnime:
SELECT * FROM anime ORDER BY orderIndex ASC;

-- One row per anime; tags aggregated for observeAllAnime() (avoids N+1 getAnimeTags calls).
getAllAnimeWithTagsConcat:
SELECT
    anime.id,
    anime.title,
    anime.imagePath,
    anime.episodes,
    anime.rating,
    anime.status,
    anime.isFavorite,
    anime.updatedAt,
    anime.orderIndex,
    anime.dateAdded,
    anime.categoryType,
    anime.sync_status,
    anime.comment,
    anime.isAiRecommendation,
    anime.anilist_id,
    anime.mal_id,
    anime.shikimori_id,
    anime.anilist_not_found_at,
    anime.mal_not_found_at,
    anime.shikimori_not_found_at,
    anime.mediaType,
    GROUP_CONCAT(anime_tags.tag, CHAR(31)) AS tagsConcat
FROM anime
LEFT JOIN anime_tags ON anime.id = anime_tags.anime_id
GROUP BY anime.id
ORDER BY anime.orderIndex ASC;

getAnimeWithTagsConcatByType:
SELECT
    anime.id,
    anime.title,
    anime.imagePath,
    anime.episodes,
    anime.rating,
    anime.status,
    anime.isFavorite,
    anime.updatedAt,
    anime.orderIndex,
    anime.dateAdded,
    anime.categoryType,
    anime.sync_status,
    anime.comment,
    anime.isAiRecommendation,
    anime.anilist_id,
    anime.mal_id,
    anime.shikimori_id,
    anime.anilist_not_found_at,
    anime.mal_not_found_at,
    anime.shikimori_not_found_at,
    anime.mediaType,
    GROUP_CONCAT(anime_tags.tag, CHAR(31)) AS tagsConcat
FROM anime
LEFT JOIN anime_tags ON anime.id = anime_tags.anime_id
WHERE anime.mediaType = ?
GROUP BY anime.id
ORDER BY anime.orderIndex ASC;

getAnimeCount:
SELECT COUNT(*) FROM anime;

getMaxOrderIndex:
SELECT COALESCE(MAX(orderIndex), 0) FROM anime;

getAnimePaged:
SELECT * FROM anime ORDER BY orderIndex ASC
LIMIT ? OFFSET ?;

getAnimeById:
SELECT * FROM anime WHERE id = ?;

insertAnime:
INSERT INTO anime(
    id, title, imagePath, episodes, rating, status, isFavorite, updatedAt, orderIndex, dateAdded,
    categoryType, sync_status, comment, isAiRecommendation,
    anilist_id, mal_id, shikimori_id,
    anilist_not_found_at, mal_not_found_at, shikimori_not_found_at,
    isPrivate, encryptionIv, deletedAt, mediaType
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'PENDING_CREATE', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateAnime:
UPDATE anime
SET title = ?,
    imagePath = ?,
    episodes = ?,
    rating = ?,
    status = ?,
    isFavorite = ?,
    updatedAt = ?,
    orderIndex = ?,
    categoryType = ?,
    sync_status = 'PENDING_UPDATE',
    comment = ?,
    isAiRecommendation = ?,
    anilist_id = ?,
    mal_id = ?,
    shikimori_id = ?,
    anilist_not_found_at = ?,
    mal_not_found_at = ?,
    shikimori_not_found_at = ?,
    isPrivate = ?,
    encryptionIv = ?,
    deletedAt = ?,
    mediaType = ?
WHERE id = ?;

updateAnimeFromSync:
UPDATE anime
SET title = ?,
    imagePath = ?,
    episodes = ?,
    rating = ?,
    status = ?,
    isFavorite = ?,
    updatedAt = ?,
    orderIndex = ?,
    categoryType = ?,
    comment = ?,
    isAiRecommendation = ?,
    anilist_id = ?,
    mal_id = ?,
    shikimori_id = ?,
    anilist_not_found_at = ?,
    mal_not_found_at = ?,
    shikimori_not_found_at = ?,
    isPrivate = ?,
    encryptionIv = ?,
    deletedAt = ?,
    mediaType = ?,
    sync_status = 'SYNCED'
WHERE id = ? AND (updatedAt < ? OR sync_status = 'SYNCED');

updateAnimeKeepingDirty:
UPDATE anime
SET anilist_id = coalesce(?, anilist_id),
    mal_id = coalesce(?, mal_id),
    shikimori_id = coalesce(?, shikimori_id)
WHERE id = ?;


setAnilistId:
UPDATE anime
SET anilist_id = ?, anilist_not_found_at = NULL, updatedAt = ?, sync_status = 'PENDING_UPDATE'
WHERE id = ?;

setMalId:
UPDATE anime
SET mal_id = ?, mal_not_found_at = NULL, updatedAt = ?, sync_status = 'PENDING_UPDATE'
WHERE id = ?;

setShikimoriId:
UPDATE anime
SET shikimori_id = ?, shikimori_not_found_at = NULL, updatedAt = ?, sync_status = 'PENDING_UPDATE'
WHERE id = ?;

markAnilistNotFound:
UPDATE anime
SET anilist_not_found_at = ?, updatedAt = ?, sync_status = 'PENDING_UPDATE'
WHERE id = ?;

markMalNotFound:
UPDATE anime
SET mal_not_found_at = ?, updatedAt = ?, sync_status = 'PENDING_UPDATE'
WHERE id = ?;

markShikimoriNotFound:
UPDATE anime
SET shikimori_not_found_at = ?, updatedAt = ?, sync_status = 'PENDING_UPDATE'
WHERE id = ?;

updateAnimeComment:
UPDATE anime SET comment = ?, updatedAt = ?, sync_status = 'PENDING_UPDATE' WHERE id = ?;

updateAnimeImagePath:
UPDATE anime SET imagePath = ? WHERE id = ?;

markAnimeSynced:
UPDATE anime SET sync_status = 'SYNCED' WHERE id = ?;

markPendingSync:
UPDATE anime SET sync_status = 'PENDING_UPDATE' WHERE id = ?;

markAllAnimeSynced:
UPDATE anime SET sync_status = 'SYNCED';

markAllAnimePendingUpload:
UPDATE anime SET sync_status = 'PENDING_UPDATE' WHERE sync_status = 'SYNCED';

deleteAnime:
DELETE FROM anime WHERE id = ?;

upsertFromSync:
INSERT OR REPLACE INTO anime(
    id, title, imagePath, episodes, rating, status, isFavorite, updatedAt, orderIndex, dateAdded,
    categoryType, sync_status, comment, isAiRecommendation,
    anilist_id, mal_id, shikimori_id,
    anilist_not_found_at, mal_not_found_at, shikimori_not_found_at,
    isPrivate, encryptionIv, deletedAt, mediaType
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'SYNCED', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

keepingDirty:
UPDATE anime
SET isPrivate = ?, encryptionIv = ?
WHERE id = ? AND sync_status != 'SYNCED';

getAnimeTags:
SELECT tag FROM anime_tags WHERE anime_id = ?;

insertAnimeTag:
INSERT INTO anime_tags(anime_id, tag)
VALUES (?, ?);

deleteAnimeTags:
DELETE FROM anime_tags WHERE anime_id = ?;

CREATE TABLE anime_update (
    anime_id TEXT NOT NULL,
    title TEXT NOT NULL,
    current_episodes INTEGER NOT NULL,
    new_episodes INTEGER NOT NULL,
    source TEXT NOT NULL,
    PRIMARY KEY (anime_id, new_episodes)
);

CREATE TABLE ignored_update (
    anime_id TEXT PRIMARY KEY NOT NULL,
    new_episodes INTEGER NOT NULL
);

getAllUpdates:
SELECT anime_id, title, current_episodes, new_episodes, source FROM anime_update;

getIgnoredMap:
SELECT anime_id, new_episodes FROM ignored_update;

insertUpdate:
INSERT OR REPLACE INTO anime_update(anime_id, title, current_episodes, new_episodes, source)
VALUES (?, ?, ?, ?, ?);

deleteAllUpdates:
DELETE FROM anime_update;

deleteUpdateByAnimeId:
DELETE FROM anime_update WHERE anime_id = ?;

setIgnored:
INSERT OR REPLACE INTO ignored_update(anime_id, new_episodes)
VALUES (?, ?);

deleteIgnored:
DELETE FROM ignored_update WHERE anime_id = ?;
