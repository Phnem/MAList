<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/vetro_window_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- API 29+: убирает серую подложку за жестовой навигацией при прозрачном navigationBar -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- API 35+: убирает серый скрим за статус-баром при edge-to-edge -->
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
