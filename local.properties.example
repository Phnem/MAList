# Copy to local.properties (not committed) and fill in as needed.

# Shikimori / MAL / AniList — OAuth для плиток «онлайн БД».
# После добавления ключей сделайте Rebuild Project (BuildConfig).
#
# Redirect URI укажите на сайте сервиса ТОЧНО так (для каждого своё):
#   Shikimori:  vetro://oauth/shikimori/callback
#   MAL:        vetro://oauth/myanimelist/callback
#   AniList:    vetro://oauth/anilist/callback
#
# Регистрация приложений:
#   https://shikimori.one/oauth/applications
#   https://myanimelist.net/apiconfig
#   https://anilist.co/settings/developer
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

